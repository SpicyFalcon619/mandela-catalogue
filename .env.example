# Required in production: a long random string used to sign login cookies.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=change-me

# Where the SQLite file lives. Put it on a persistent disk/volume in production.
DATABASE_PATH=./data/mandela.db

# Optional: creates this admin account on first start if it does not exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
